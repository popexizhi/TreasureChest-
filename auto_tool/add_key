pd="tdp#2023@hdyz"
ip=$1
./sshpass -p "${pd}" scp backup_authorized_keys root@${ip}:"~"
./sshpass -p "${pd}" ssh root@${ip} "if [ ! -d ~/.ssh ];then mkdir ~/.ssh&&chmod 700 ~/.ssh&&touch ~/.ssh/authorized_keys ;fi" 
./sshpass -p "${pd}" ssh root@${ip} "cat ~/backup_authorized_keys>>~/.ssh/authorized_keys&&rm -rf backup_authorized_keys"

